# Copy to .env and fill in for your qualification environment.
# NEVER commit real credentials. These are test-instance credentials only.

# Application under test (IQ-14: HTTPS)
OC_BASE_URL=https://localhost

# --- Test user accounts (created per SOP-001 / CFG-010..014) ---
OC_ADMIN_USER=admin1
OC_ADMIN_PASS=change-me
OC_DM_USER=dm1
OC_DM_PASS=change-me
OC_CRA_USER=cra1
OC_CRA_PASS=change-me
OC_DE_USER=de1
OC_DE_PASS=change-me
OC_INV_USER=inv1
OC_INV_PASS=change-me

# --- OpenClinica PostgreSQL: READ-ONLY evidence source (src/audit-db.ts) ---
# This connection extracts audit-trail evidence and must NOT be write-capable.
PGHOST=localhost
PGPORT=5432
PGDATABASE=openclinica
PGUSER=oc_readonly
PGPASSWORD=change-me

# --- OpenClinica PostgreSQL: PRIVILEGED fixture/immutability connection (src/admin-db.ts) ---
# Used ONLY for test setup/teardown and the OQ-15 functional tamper attempt (which is
# always rolled back). Must be a role that WOULD be allowed to write, so that a rejected
# audit-table write proves an enforced trigger, not a missing privilege. Falls back to
# PGUSER/PGPASSWORD if unset. Use the app role "openclinica" or a test superuser.
PGADMIN_USER=openclinica
PGADMIN_PASSWORD=change-me

# --- Dedicated, EXPENDABLE account for the lockout test (OQ-28) ---
# Do NOT reuse a role account here: this account gets locked by design. Leaving it locked
# cannot affect other tests. It is reset at the next run's start and manually per SOP-001.
OC_LOCKOUT_USER=lock1
OC_LOCKOUT_PASS=change-me

# Study / subject identifiers used by the OQ (disposable test data)
OC_STUDY_OID=NWT-ORX201-201
OC_TEST_SUBJECT=S-901

# Optional: values changed during the OQ data-entry step, for the targeted OQ-12b check
# OQ_OLD_VALUE=120
# OQ_NEW_VALUE=125
