# docker compose interpolation variables. This file lives in the docker/ folder and is
# read automatically by `docker compose` when named `.env` in THIS directory.
#
#   copy .env.example .env      (Windows)   /   cp .env.example .env   (bash)
#
# NOTE: this is SEPARATE from ../.env, which configures the Playwright harness.
# DB_APP_PASSWORD is the password for the 'openclinica' PostgreSQL application role.
# It MUST match PGADMIN_PASSWORD in ../.env, because the harness's privileged
# connection (src/admin-db.ts) logs in as the 'openclinica' role.

DB_APP_PASSWORD=change-me-strong
